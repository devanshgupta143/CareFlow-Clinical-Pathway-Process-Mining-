		summarizeBy: none
		sourceColumn: Process_Time_Hours

	partition clinical_events = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\Lenovo\CareFlow-Clinical-Pathway-Process-Mining\data\clinical_events.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    CleanHeaders = Table.TransformColumnNames(PromotedHeaders, each Text.Trim(_)),
				    RemovedPatientName = Table.RemoveColumns(
				        CleanHeaders,
				        {"patient_name"},
				        MissingField.Ignore
				    ),
				    RenamedColumns = Table.RenameColumns(
				        RemovedPatientName,
				        {
				            {"case_id", "Case_ID"},
				            {"event_activity", "Activity_Name"},
				            {"event_time", "Timestamp"},
				            {"department", "Department"},
				            {"hospital", "Hospital"},
				            {"patient_type", "Patient_Type"},
				            {"primary_diagnosis", "Primary_Diagnosis"},
				            {"stage", "Stage"},
				            {"wait_time_hours", "Wait_Time_Hours"},
				            {"process_time_hours", "Process_Time_Hours"}
				        },
				        MissingField.Error
				    ),
				    CleanedText = Table.TransformColumns(
				        RenamedColumns,
				        {
				            {"Case_ID", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Activity_Name", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Department", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Hospital", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Patient_Type", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Primary_Diagnosis", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Stage", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text}
				        }
				    ),
				    TypedValues = Table.TransformColumns(
				        CleanedText,
				        {
				            {"Timestamp", each try DateTime.From(_) otherwise null, type nullable datetime},
				            {"Wait_Time_Hours", each try Number.From(_) otherwise null, type nullable number},
				            {"Process_Time_Hours", each try Number.From(_) otherwise null, type nullable number}
				        }
				    ),
				    CaseDurations = Table.Group(
				        TypedValues,
				        {"Case_ID"},
				        {
				            {
				                "DurationDays",
				                each
				                    let
				                        ValidTimestamps = List.RemoveNulls([Timestamp])
				                    in
				                        if List.IsEmpty(ValidTimestamps) then
				                            null
				                        else
				                            Duration.TotalDays(List.Max(ValidTimestamps) - List.Min(ValidTimestamps)),
				                type nullable number
				            }
				        }
				    ),
				    MergedDurations = Table.NestedJoin(
				        TypedValues,
				        {"Case_ID"},
				        CaseDurations,
				        {"Case_ID"},
				        "CaseDuration",
				        JoinKind.LeftOuter
				    ),
				    ExpandedDurations = Table.ExpandTableColumn(
				        MergedDurations,
				        "CaseDuration",
				        {"DurationDays"},
				        {"DurationDays"}
				    ),
				    Result = Table.TransformColumnTypes(
				        ExpandedDurations,
				        {
				            {"Case_ID", type text},
				            {"Activity_Name", type text},
				            {"Timestamp", type datetime},
				            {"Department", type text},
				            {"Hospital", type text},
				            {"Patient_Type", type text},
				            {"Primary_Diagnosis", type text},
				            {"Stage", type text},
				            {"Wait_Time_Hours", type number},
				            {"Process_Time_Hours", type number},
				            {"DurationDays", type number}
				        },
				        "en-US"
				    )
				in
				    Result

	annotation PBI_ResultType = Table

