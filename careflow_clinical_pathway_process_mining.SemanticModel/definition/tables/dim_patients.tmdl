	partition dim_patients = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\\Users\\Lenovo\\CareFlow-Clinical-Pathway-Process-Mining\\data\\case_metadata.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    CleanHeaders = Table.TransformColumnNames(PromotedHeaders, each Text.Trim(_)),
				    RenamedColumns = Table.RenameColumns(
				        CleanHeaders,
				        {
				            {"case_id", "Case_ID"},
				            {"total_length_of_stay_days", "Total_Length_of_Stay_Days"},
				            {"total_process_time_hours", "Total_Process_Time_Hours"},
				            {"is_readmitted", "Is_Readmitted"},
				            {"patient_satisfaction_pct", "Patient_Satisfaction_Pct"},
				            {"delayed_discharge_reason", "Delayed_Discharge_Reason"}
				        },
				        MissingField.Error
				    ),
				    WithAge = if Table.HasColumns(RenamedColumns, "Age") then
				        RenamedColumns
				    else
				        Table.AddColumn(RenamedColumns, "Age", each null, Int64.Type),
				    WithGender = if Table.HasColumns(WithAge, "Gender") then
				        WithAge
				    else
				        Table.AddColumn(WithAge, "Gender", each null, type nullable text),
				    WithRiskScore = if Table.HasColumns(WithGender, "Risk_Score") then
				        WithGender
				    else
				        Table.AddColumn(WithGender, "Risk_Score", each null, type nullable number),
				    WithSatisfactionScore = if Table.HasColumns(WithRiskScore, "Satisfaction_Score") then
				        WithRiskScore
				    else
				        Table.AddColumn(WithRiskScore, "Satisfaction_Score", each [Patient_Satisfaction_Pct], type nullable number),
				    CleanText = Table.TransformColumns(
				        WithSatisfactionScore,
				        {
				            {"Case_ID", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Delayed_Discharge_Reason", each if _ = null or Text.Lower(Text.Trim(Text.From(_))) = "none" then null else Text.Trim(Text.From(_)), type nullable text}
				        }
				    ),
				    TypedValues = Table.TransformColumns(
				        CleanText,
				        {
				            {"Total_Length_of_Stay_Days", each try Number.From(_) otherwise null, type nullable number},
				            {"Total_Process_Time_Hours", each try Number.From(_) otherwise null, type nullable number},
				            {"Is_Readmitted", each try Logical.From(_) otherwise null, type nullable logical},
				            {"Patient_Satisfaction_Pct", each try Number.From(_) otherwise null, type nullable number},
				            {"Satisfaction_Score", each try Number.From(_) otherwise null, type nullable number},
				            {"Age", each try Int64.From(_) otherwise null, Int64.Type},
				            {"Gender", each if _ = null then null else Text.Trim(Text.From(_)), type nullable text},
				            {"Risk_Score", each try Number.From(_) otherwise null, type nullable number}
				        }
				    ),
				    Result = Table.TransformColumnTypes(
				        Table.SelectColumns(
				            TypedValues,
				            {
				                "Case_ID",
				                "Age",
				                "Gender",
				                "Risk_Score",
				                "Satisfaction_Score",
				                "Total_Length_of_Stay_Days",
				                "Total_Process_Time_Hours",
				                "Is_Readmitted",
				                "Patient_Satisfaction_Pct",
				                "Delayed_Discharge_Reason"
				            }
				        ),
				        {
				            {"Case_ID", type text},
				            {"Age", Int64.Type},
				            {"Gender", type text},
				            {"Risk_Score", type number},
				            {"Satisfaction_Score", type number},
				            {"Total_Length_of_Stay_Days", type number},
				            {"Total_Process_Time_Hours", type number},
				            {"Is_Readmitted", type logical},
				            {"Patient_Satisfaction_Pct", type number},
				            {"Delayed_Discharge_Reason", type text}
				        },
				        "en-US"
				    )
				in
				    Result

	annotation PBI_ResultType = Table

